# ==================================
# Totonos Environment Configuration
# ==================================

# Supabase Configuration (Required)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# E2E Testing (Required for authenticated tests)
# Set a secret key for E2E auto-login (only works in development mode)
# Usage: login with email like "test+e2e-{YOUR_KEY}@example.com"
VITE_E2E_TEST_KEY="your-secret-test-key"

# Production Domain (Required)
VITE_APP_URL="https://totonos.jp"

# ==================================
# Monitoring & Analytics
# ==================================

# Sentry (Error Monitoring)
VITE_SENTRY_DSN="your-sentry-dsn"

# ==================================
# Payment Integration
# ==================================

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
VITE_STRIPE_PRO_PRICE_ID="price_..."
STRIPE_SECRET_KEY="sk_test_..."  # Server-side only
STRIPE_WEBHOOK_SECRET="whsec_..." # Server-side only
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."

# ==================================
# External APIs
# ==================================

# Google Cloud Vision (OCR)
GOOGLE_CLOUD_VISION_API_KEY="your-vision-api-key"

# Gmail/Google Calendar OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Microsoft/Outlook OAuth
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"

# Plaid (Bank Integration)
PLAID_CLIENT_ID="your-plaid-client-id"
PLAID_SECRET="your-plaid-secret"
PLAID_ENV="sandbox"  # sandbox | development | production

# ==================================
# Feature Flags (Optional)
# ==================================

# Enable/disable features
VITE_ENABLE_OCR="true"
VITE_ENABLE_AI_SCORING="true"
VITE_ENABLE_BANK_SYNC="true"
VITE_ENABLE_SSO="false"
