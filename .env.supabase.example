# ===========================================
# Self-hosted Supabase 環境変数
# ===========================================
# このファイルを .env.supabase にコピーして編集してください
# cp .env.supabase.example .env.supabase

# ===========================================
# PostgreSQL
# ===========================================
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
POSTGRES_DB=postgres

# ===========================================
# JWT (認証トークン)
# ===========================================
# 以下のコマンドで生成: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# JWT有効期限（秒）
JWT_EXPIRY=3600

# ===========================================
# API Keys
# ===========================================
# 以下のサイトで生成: https://supabase.com/docs/guides/self-hosting#api-keys
# または: npx @supabase/generate-keys --secret your-jwt-secret

# 公開キー（クライアントで使用）
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# サービスキー（サーバーサイドで使用、公開しないこと）
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ===========================================
# URLs
# ===========================================
# 本番環境では適切なURLに変更
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000

# OAuth用の追加リダイレクトURL（カンマ区切り）
ADDITIONAL_REDIRECT_URLS=

# ===========================================
# Email (SMTP)
# ===========================================
# メール認証を使用する場合は設定
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_ADMIN_EMAIL=admin@example.com

# ===========================================
# Features
# ===========================================
# 新規登録を無効化
DISABLE_SIGNUP=false

# メール確認をスキップ（開発用）
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_EMAIL_SIGNUP=true

# ===========================================
# Studio (管理画面)
# ===========================================
STUDIO_DEFAULT_ORGANIZATION=Totonos
STUDIO_DEFAULT_PROJECT=Totonos
